# Dependencies — restorable from package-lock.json, which IS committed.
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
*.png.tmp

# Secrets. Nothing here reads env vars today, but this project has held API
# keys before — keep the door shut rather than remembering to shut it later.
.env
.env.*
!.env.example

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*~

# Scratch space — local experiments that should never reach the repo
scratch/
tmp/
